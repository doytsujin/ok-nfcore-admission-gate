/*
 * Shared by BOTH the baseline and the gated run.
 *
 * Anything that could change task timing must live here, not in gate.config,
 * so the only difference between the two runs is the gate itself. That is the
 * whole basis of the overhead measurement.
 */

// Rootless podman on an SELinux host (Rocky/RHEL family) needs the bind mount
// relabelled, or the container cannot read its own work directory and every
// task dies with exit 126. Nextflow does not set this by default.
podman.mountFlags = 'z'

// Both runs write a trace; allow re-runs without hand-deleting files first.
trace.overwrite  = true
report.overwrite = true

// Keep the comparison single-threaded in scheduling terms. Without this the
// two runs can interleave containers differently and the wall-clock delta
// stops being attributable to the gate.
executor.queueSize = 1
