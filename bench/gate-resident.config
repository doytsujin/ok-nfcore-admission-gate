/*
 * The resident-gate arm.
 *
 * Identical to gate.config except for HOW the decision is delivered. The policy
 * is the same, the descriptors are the same, the conditions are the same --
 * only the transport changes, which is the whole point of the comparison.
 *
 * The client is bash's own /dev/tcp. It has to be: the cost being removed is
 * `python3 -m gate` process creation at ~30 ms, so a client that starts a
 * process would give back what the daemon saves. The shell running
 * `beforeScript` already exists, and /dev/tcp is a bash builtin -- nothing is
 * forked.
 */

includeConfig 'common.config'

params.gatePort   = System.getenv('GATE_PORT') ?: '8731'
params.gateHost   = System.getenv('GATE_HOST') ?: '127.0.0.1'

params.ctxPlatform      = System.getenv('GATE_CTX_PLATFORM') ?: 'illumina'
params.ctxMinReadLength = System.getenv('GATE_CTX_MINREADLEN') ?: '30'
params.ctxReportFormat  = System.getenv('GATE_CTX_REPORTFORMAT') ?: 'multiqc'
params.ctxMinInputStages = System.getenv('GATE_CTX_MININPUTSTAGES') ?: '2'

def residentCall = { String dataset, String action, String ctx ->
    // exec 3<>/dev/tcp/... opens the socket in the current shell. A non-PERMIT
    // reply exits 3, exactly as the subprocess gate does, so the two arms fail
    // tasks identically and the only difference is transport.
    return """
    exec 3<>/dev/tcp/${params.gateHost}/${params.gatePort} || { echo 'gate: unreachable' >&2; exit 1; }
    printf '%s\\n' "${dataset} ${action} ${ctx}" >&3
    read -r __gate_reply <&3
    exec 3<&-
    case "\$__gate_reply" in
      PERMIT*) ;;
      *) echo "gate: \$__gate_reply" >&2; exit 3 ;;
    esac
    """.stripIndent()
}

process {
    withName: 'FASTQC' {
        beforeScript = residentCall('raw-reads', 'qc', "platform=${params.ctxPlatform}")
    }
    withName: 'SEQTK_TRIM' {
        beforeScript = residentCall('raw-reads', 'trim',
            "platform=${params.ctxPlatform} minReadLength=${params.ctxMinReadLength}")
    }
    withName: 'MULTIQC' {
        beforeScript = residentCall('qc-report', 'aggregate',
            "reportFormat=${params.ctxReportFormat} minInputStages=${params.ctxMinInputStages}")
    }
}
