/*
 * The gated run. Identical to the baseline except for `beforeScript`.
 *
 * `process.beforeScript` is a real pre-execution hook: Nextflow runs it inside
 * the task's own working directory, immediately before the task script, and a
 * non-zero exit fails the task. That is what makes this a *prospective*
 * admission gate rather than a report written after the fact -- if the gate
 * refuses, the tool never runs.
 *
 * Each process is mapped to the dataset it consumes and the action it
 * performs. The mapping is explicit per process rather than inferred, because
 * a gate that guesses which policy applies is not a gate.
 */

includeConfig 'common.config'

params.gateRoot   = System.getenv('GATE_ROOT')
params.gateLog    = System.getenv('GATE_LOG')
params.gateRunId  = System.getenv('GATE_RUN_ID') ?: 'gated'
params.gateDryRun = (System.getenv('GATE_DRY_RUN') == '1')

// Context values the policy conditions are evaluated against. In a real
// deployment these come from the run's own parameters and the upstream
// descriptor; here they are declared once so both the permit and refusal
// scenarios are reproducible.
params.ctxPlatform      = System.getenv('GATE_CTX_PLATFORM') ?: 'illumina'
params.ctxMinReadLength = System.getenv('GATE_CTX_MINREADLEN') ?: '30'
params.ctxReportFormat  = System.getenv('GATE_CTX_REPORTFORMAT') ?: 'multiqc'
params.ctxMinInputStages = System.getenv('GATE_CTX_MININPUTSTAGES') ?: '2'

def gateCall = { String dataset, String action, String ctx ->
    def dry = params.gateDryRun ? '--dry-run' : ''
    return "python3 -m gate --descriptors ${params.gateRoot}/descriptors " +
           "--dataset ${dataset} --action ${action} --log ${params.gateLog} " +
           "--run-id ${params.gateRunId} --task \"\$NXF_TASK_WORKDIR\" " +
           "--context ${ctx} ${dry}"
}

process {
    // The gate module is imported from the repo root; PYTHONPATH makes
    // `python3 -m gate` resolvable from inside the task work directory.
    beforeScript = "export PYTHONPATH=${params.gateRoot}"

    withName: 'FASTQC' {
        beforeScript = "export PYTHONPATH=${params.gateRoot}; " +
            gateCall('raw-reads', 'qc', "platform=${params.ctxPlatform}")
    }

    withName: 'SEQTK_TRIM' {
        beforeScript = "export PYTHONPATH=${params.gateRoot}; " +
            gateCall('raw-reads', 'trim',
                     "platform=${params.ctxPlatform} minReadLength=${params.ctxMinReadLength}")
    }

    withName: 'MULTIQC' {
        beforeScript = "export PYTHONPATH=${params.gateRoot}; " +
            gateCall('qc-report', 'aggregate',
                     "reportFormat=${params.ctxReportFormat} minInputStages=${params.ctxMinInputStages}")
    }
}
