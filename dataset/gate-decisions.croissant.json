  "@type": "sc:Dataset",
  "name": "gate-decisions",
  "description": "admission_decision_records described as a policy-bearing Croissant dataset. State: REPLICATED. Source: 30 interleaved replicates of three arms (baseline, gated, refuse) of nf-core/demo v1.0.1 under a prospective admission gate, on real nf-core/test-datasets Illumina amplicon reads.",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.0",
    "https://example.invalid/croissant-policy/0.1.0"
  ],
  "version": "1.0.0",
  "url": "https://github.com/doytsujin/ok-nfcore-admission-gate",
  "license": "https://spdx.org/licenses/MIT.html",
  "creator": {
    "@type": "sc:Organization",
    "name": "ok-nfcore-admission-gate"
  },
  "additionalType": "admission_decision_records",
  "rai:dataCollection": "30 interleaved replicates of three arms (baseline, gated, refuse) of nf-core/demo v1.0.1 under a prospective admission gate, on real nf-core/test-datasets Illumina amplicon reads",
  "measurementTechnique": "bench/replicate.sh",
  "variableMeasured": [
    {
      "@type": "sc:PropertyValue",
      "name": "engine",
      "value": "nextflow-24.10.5"
    },
    {
      "@type": "sc:PropertyValue",
      "name": "layout",
      "value": "one-record-per-decision"
    },
    {
      "@type": "sc:PropertyValue",
      "name": "pipeline",
      "value": "nf-core/demo-1.0.1"
    }
  ],
  "distribution": [
    {
      "@type": "cr:FileSet",
      "@id": "gate-decisions-files",
      "name": "gate-decisions-files",
      "description": "The admission_decision_records files of this dataset, in jsonl form. The native descriptor records the shape of the data and not its location, so this FileSet has no containedIn; the location is supplied by whoever mounts the dataset.",
      "encodingFormat": "application/jsonl",
      "includes": "*.jsonl"
    },
    {
      "@type": "cr:FileSet",
      "@id": "replicates",
      "name": "replicates",
      "description": "Decision records emitted by the gate for this dataset.",
      "encodingFormat": "application/jsonl",
      "includes": "results/replicates/*.jsonl"
    }
  ],
  "cpol:policy": {
    "@type": "cpol:Policy",
    "cpol:state": "REPLICATED",
    "cpol:failClosed": true,
    "cpol:classification": "public-derived-measurement",
    "cpol:custodian": "ok-nfcore-admission-gate",
    "cpol:retentionDays": 3650,
    "cpol:rationale": "Timings and decision records over public test data. Nothing here is restricted; the conditions exist so that a consumer cannot quietly reuse a subset the published interval was not computed over.",
    "cpol:permissibleAction": [
      {
        "@type": "cpol:Action",
        "cpol:actionName": "analyze",
        "cpol:requiresState": [
          "REPLICATED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "arm",
            "cpol:operator": "cpol:in",
            "cpol:expected": [
              "baseline",
              "gated",
              "refuse"
            ]
          },
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "replicates",
            "cpol:operator": "cpol:min",
            "cpol:expected": 30
          }
        ]
      },
      {
        "@type": "cpol:Action",
        "cpol:actionName": "cite",
        "cpol:requiresState": [
          "REPLICATED",
          "ARCHIVED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "manifestSha256",
            "cpol:operator": "cpol:present",
            "cpol:expected": true
          }
        ]
      },
      {
        "@type": "cpol:Action",
        "cpol:actionName": "redistribute",
        "cpol:requiresState": [
          "ARCHIVED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "decisionRecords",
            "cpol:operator": "cpol:min",
            "cpol:expected": 210
          }
        ]
      }
    ],
    "cpol:decisionRecord": {
      "@id": "replicates"
    }
  }
}
