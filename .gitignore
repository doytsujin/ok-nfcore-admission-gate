toolchain/
# Trace files are kept; run outputs and work directories are not. The traces are
# not build output -- they are the evidence the README's tables and the corpus in
# DATASET.md are computed from, and a manifest pointing at files that are not in
# the repository describes nothing. The *_out and work_* trees beside them are
# ~95 MB of regenerable pipeline output and stay ignored.
#
# Written as `runs/*` rather than `runs/` on purpose: git cannot re-include a
# path whose parent directory is itself excluded, so excluding children
# individually is what makes the negations below work at all.
runs/*
!runs/*_trace.txt
!runs/replicates/
runs/replicates/*
!runs/replicates/*_trace.txt
pipeline-nfcore-demo/
__pycache__/
*.pyc
.nextflow*

# The AWS arm keeps its evidence and drops its scratch. Same rule as runs/:
# children are excluded individually so the negations below can re-include.
# e1_local_control.json is the calibration of the probes and is evidence;
# the zips are regenerable packaging and the *_probe.out files are copies of
# what the JSON already records.
aws/results/*
!aws/results/e1_local_control.json
!aws/results/e1_probe.json
!aws/results/e1_evidence.md
!aws/results/e1c_container.json
!aws/results/e1c_local_control.md
!aws/results/gate_real.json
!aws/results/gate_real_evidence.md
!aws/results/e3_runs.jsonl
!aws/results/e3_granularity.json
!aws/results/e3_meta.json
