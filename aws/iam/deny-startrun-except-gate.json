{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheGateMayStartRuns",
      "Effect": "Deny",
      "Action": "omics:StartRun",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:sts::ACCOUNT_ID:assumed-role/nfgate-startrun-gate-role/*"
        }
      }
    },
    {
      "Sid": "AndMayNotEditTheirWayOutOfIt",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePolicy",
        "iam:PutRolePolicy",
        "iam:DetachRolePolicy",
        "iam:AttachRolePolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/nfgate-startrun-gate-role"
    }
  ]
}
