/*
 * nf-core/demo, adjusted for AWS HealthOmics. Included only when running there
 * -- see the includeConfig guard appended to the packaged nextflow.config --
 * so the vendored pipeline stays runnable locally and unmodified on disk.
 *
 * Containers are pinned to ECR because HealthOmics tasks have no outbound
 * internet access. The URIs are filled in at packaging time from the account
 * and region actually in use; the placeholders below are not valid as written.
 *
 * NOTE what is deliberately absent: there is no `beforeScript` here. That is
 * the whole finding. The local gated arm gates every one of these three
 * processes; this file cannot, so the only enforcement point left is in front
 * of StartRun, one level up and one granularity coarser.
 */

params.outdir = '/mnt/workflow/pubdir'

process {
    // HealthOmics selects an omics.* instance from these, so they are also
    // the cost model. Kept modest and identical across arms -- a difference
    // here would show up as a difference in the measurement.
    cpus   = 2
    memory = '4 GB'

    withName: 'FASTQC' {
        container = "__ECR_BASE__/nfgate/fastqc:0.12.1--hdfd78af_0"
    }
    withName: 'SEQTK_TRIM' {
        container = "__ECR_BASE__/nfgate/seqtk:1.4--he4a0461_1"
    }
    withName: 'MULTIQC' {
        container = "__ECR_BASE__/nfgate/multiqc:1.25.1--pyhdfd78af_0"
    }
}

// The trace is the measurement. Written under /mnt/workflow/output/ because
// HealthOmics exports only that prefix to the run's S3 output location, and a
// trace that stays inside the run is not evidence of anything.
trace {
    enabled   = true
    file      = '/mnt/workflow/output/trace.txt'
    overwrite = true
    fields    = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,memory'
}
