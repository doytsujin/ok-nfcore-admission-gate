/*
 * Pinned so the result is attributable to a version. HealthOmics selects its
 * engine from manifest.nextflowVersion; leaving it unpinned would make a
 * later re-run a different experiment.
 */
manifest {
    nextflowVersion = '!>=24.04.0'
}

// '/mnt/workflow/pubdir' is what HealthOmics requires; the local control
// overrides it with -params-file or --pubdir.
params.pubdir = '/mnt/workflow/pubdir'
